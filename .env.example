# ---------------------------------------------------------------------------
# Secrets. Copy to `.env` and fill in. NEVER commit the real .env file.
#
#   cp .env.example .env
#
# IMPORTANT: the CoinMarketCap key that was hard-coded in the original
# cmc_fetcher.py has been exposed. Revoke it at pro.coinmarketcap.com and
# generate a new one before using this project.
# ---------------------------------------------------------------------------

# --- CoinMarketCap (index price) -------------------------------------------
# Free tier: https://pro.coinmarketcap.com/  ->  API Keys
CMC_API_KEY=

# --- RPC node (DEX price) ----------------------------------------------------
# Leave blank to use the free public endpoints in config.py (they work, but
# they are rate-limited and can lag). For anything time-sensitive use your own:
#   Infura   https://infura.io        ->  https://mainnet.infura.io/v3/<PROJECT_ID>
#   Alchemy  https://alchemy.com      ->  https://eth-mainnet.g.alchemy.com/v2/<KEY>
ETH_RPC_URL=
BASE_RPC_URL=
BSC_RPC_URL=
BSC_TESTNET_RPC_URL=

# --- Market / behaviour ------------------------------------------------------
DEX_NETWORK=ethereum        # ethereum | base | bsc | bsc_testnet
BASE_SYMBOL=ETH
QUOTE_SYMBOL=USDT
DEX_VERSION=auto            # auto | v3 | v2
INDEX_SOURCE=auto           # auto | cmc | coinbase | kraken

# WHICH DEX to price against. Blank means "use this network's default":
# Uniswap on ethereum/base, PancakeSwap V2 on bsc (there is no Uniswap V2 on
# BNB Chain). Set it to pin a venue, e.g. for scanning PancakeSwap on Ethereum:
#   uniswap_v2 | uniswap_v3 | pancakeswap_v2 | pancakeswap_v3
# Every venue is also reachable per-command with --venue, which overrides this.
# `python main.py cross --network bsc` lists all of a network's venues at once
# and does not need this setting at all.
DEX_VENUE=

# Failover order for the reference price. FIRST one that answers wins, so this
# decides what a plain `scan` reports. Venues with a real order book rank above
# CoinMarketCap's aggregated index: only a book gives an executable bid/ask, and
# comparing a DEX price to an index MID invents roughly half the venue's spread
# as phantom edge. Set to cmc,kraken,coinbase to restore CoinMarketCap-first.
INDEX_SOURCE_ORDER=kraken,coinbase,cmc

TRADE_SIZE_BASE=1.0         # size used for the executable quote
MIN_EDGE_BPS=15             # gross edge required before a signal fires
MAX_SLIPPAGE_BPS=50         # reject quotes with more fee+impact than this
# `cross` only: a quote whose REALISED price impact at your size exceeds this
# is rejected before any edge is computed. This is the depth gate - without it a
# pool holding a dust balance of the base token prices your trade against a
# near-zero reserve and reports a six-figure "edge". --max-impact overrides it.
MAX_IMPACT_BPS=50

INCLUDE_GAS=1
GAS_UNITS=180000            # ~a V3 swap; raise for multi-hop or Ethereum L1
POLL_SECONDS=5
RPC_TIMEOUT=10
REQUEST_TIMEOUT=15

LOG_JSONL=logs/signals.jsonl

# --- Only needed if you later add execution ----------------------------------
# A bot that only READS prices needs no key at all. Keep it out of the repo.
ARB_PRIVATE_KEY=
