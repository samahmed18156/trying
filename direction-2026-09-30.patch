+    best_hour = max(by_hour.items(), key=lambda kv: kv[1]["net_median"] or -1e9)
+    best_size = max(by_size.items(), key=lambda kv: kv[1]["net_median"] or -1e9)
+
+    if not positive:
+        return {
+            "state": "negative",
