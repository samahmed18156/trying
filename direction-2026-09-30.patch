+            readers[venue_key] = (UniswapV3Reader(reader, venue=venue)
+                                  if venue is not None else None)
+        bound = readers[venue_key]
+        if bound is None:
+            return lambda fee: ""
+        return lambda fee: bound.pool_for_fee(base, quote, fee)
+
+    return for_venue
